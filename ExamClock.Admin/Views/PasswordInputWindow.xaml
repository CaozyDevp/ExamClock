<Window x:Class="ExamClock.Admin.Views.PasswordInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:ExamClock.Admin.Views"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Width="380"
        Height="170"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      CornerRadius="10"
                      GlassFrameThickness="-1"
                      ResizeBorderThickness="5"
                      UseAeroCaptionButtons="True" />
    </WindowChrome.WindowChrome>

    <Border BorderThickness="1"
            Background="White"
            BorderBrush="LightGray">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!--  标题栏  -->
            <Border Grid.Row="0"
                    Height="30"
                    Background="#F3F3F3">
                <Grid>
                    <TextBlock Margin="14,0,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Text="密码校验"
                               FontSize="14" />
                    <Button Name="CloseWindowButton"
                            Width="30"
                            Height="30"
                            HorizontalAlignment="Right"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseWindowButton_Click">
                        <Button.Template>
                            <ControlTemplate>
                                <Image Source="/Assets/Images/Close.png"
                                       Width="9" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Height="80"
                  Width="300">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Padding="0"
                           Foreground="#818181"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Text="账号"
                           FontFamily="{StaticResource Hei}"
                           FontSize="18" />
                <TextBox Name="UsernameInputBox"
                         Grid.Row="0"
                         Grid.Column="1"
                         Foreground="Black"
                         VerticalAlignment="Center"
                         FontFamily="{StaticResource Hei}"
                         FontSize="18" />
                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Padding="0"
                           Foreground="#818181"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Text="密码"
                           FontFamily="{StaticResource Hei}"
                           FontSize="18" />
                <StackPanel Grid.Row="1"
                            Grid.Column="1"
                            Orientation="Horizontal">
                    <PasswordBox Name="PasswordInputBox"
                                 Height="26"
                                 Width="220"
                                 HorizontalAlignment="Stretch"
                                 FontSize="18" />
                    <Button Width="30"
                            Height="26"
                            Name="SubmitButton"
                            hc:IconElement.Geometry="{StaticResource RightGeometry}"
                            FontSize="18"
                            Click="SubmitButton_Click"
                            IsDefault="True" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>