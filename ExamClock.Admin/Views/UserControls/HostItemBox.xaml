<UserControl x:Class="ExamClock.Admin.Views.UserControls.HostItemBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ExamClock.Admin.Views.UserControls"
             mc:Ignorable="d"
             Height="165" Width="270"
             d:DesignHeight="165"
             d:DesignWidth="270">
    <UserControl.Resources>
        <SolidColorBrush Color="#FAFDFF"
                         x:Key="BlueBackground" />
        <SolidColorBrush Color="#0090FF"
                         x:Key="BlueBorder" />
        <SolidColorBrush Color="#FFF7F7"
                         x:Key="RedBackground" />
        <SolidColorBrush Color="#FF0000"
                         x:Key="RedBorder" />
        <SolidColorBrush Color="#646464"
                         x:Key="DarkGray" />
        <SolidColorBrush Color="#808080"
                         x:Key="LightGray" />
        <SolidColorBrush Color="#009728"
                         x:Key="ActiveGreen" />
        <SolidColorBrush Color="#970000"
                         x:Key="InactiveRed" />
    </UserControl.Resources>

    <Border BorderBrush="{Binding BorderColorBrush,RelativeSource={RelativeSource AncestorType=local:HostItemBox}}"
            BorderThickness="2"
            CornerRadius="10"
            Background="{Binding BackgroundBrush,RelativeSource={RelativeSource AncestorType=local:HostItemBox}}">
        <Grid Margin="27 0 0 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="20" />
                <RowDefinition Height="38" />
                <RowDefinition />
                <RowDefinition Height="39" />
            </Grid.RowDefinitions>
            <Label Grid.Row="1"
                   Padding="0"
                   Content="{Binding RoomNumberString,RelativeSource={RelativeSource AncestorType=local:HostItemBox}}"
                   FontSize="23"
                   FontFamily="{StaticResource Hei}" />
            <Label Grid.Row="1"
                   Padding="0"
                   Content="{Binding IpString,RelativeSource={RelativeSource AncestorType=local:HostItemBox}}"
                   FontSize="18"
                   Margin="90 6 0 0"
                   HorizontalAlignment="Left"
                   Foreground="{StaticResource DarkGray}"
                   FontFamily="{StaticResource Hei}" />
            <Grid Grid.Row="2"
                  Height="55"
                  VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Image Source="/Assets/Images/Clock.png"
                       Width="18"
                       Grid.Row="0"
                       Grid.Column="0" />
                <Label Grid.Row="0"
                       Grid.Column="1"
                       Content="{Binding TimeString,RelativeSource={RelativeSource AncestorType=local:HostItemBox}}"
                       FontSize="18"
                       VerticalAlignment="Center"
                       Padding="5 0 0 0"
                       FontFamily="{StaticResource Hei}"
                       Foreground="{StaticResource LightGray}" />
                <Image Source="/Assets/Images/Bell.png"
                       Width="18"
                       Grid.Row="1"
                       Grid.Column="0" />
                <Label Grid.Row="1"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       Padding="5 0 0 0"
                       Content="{Binding NoticeString,RelativeSource={RelativeSource AncestorType=local:HostItemBox}}"
                       FontSize="18"
                       FontFamily="{StaticResource Hei}"
                       Foreground="{StaticResource LightGray}" />
            </Grid>
            <Label Foreground="{Binding StatusBrush,RelativeSource={RelativeSource AncestorType=local:HostItemBox}}"
                   Content="{Binding StatusString,RelativeSource={RelativeSource AncestorType=local:HostItemBox}}"
                   Grid.Row="3"
                   FontSize="18"
                   Padding="0"
                   FontFamily="{StaticResource Hei}" />
            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0 0 17 0">
                <Image Source="/Assets/Images/Volume.png"
                       Width="18" />
                <Label Foreground="{StaticResource LightGray}"
                       Content="{Binding VolumeString,RelativeSource={RelativeSource AncestorType=local:HostItemBox}}"
                       VerticalAlignment="Center"
                       FontSize="18"
                       Padding="0"
                       Margin="4 0 0 0"
                       FontFamily="{StaticResource Hei}" />
            </StackPanel>

        </Grid>
    </Border>
</UserControl>
