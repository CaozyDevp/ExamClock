<UserControl
    x:Class="ExamClock.Views.UserControls.ExamItemBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ExamClock.Views.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="35"
    d:DesignWidth="440"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*" />
            <ColumnDefinition Width="5*" />
            <ColumnDefinition Width="4*" />
        </Grid.ColumnDefinitions>

        <TextBlock
            Grid.Column="0"
            MaxWidth="110"
            Margin="5,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            FontFamily="{StaticResource Hei}"
            FontSize="23"
            Foreground="#2E4959"
            Text="{Binding SubjectText, RelativeSource={RelativeSource AncestorType=local:ExamItemBox}}"
            TextTrimming="CharacterEllipsis"
            ToolTip="{Binding SubjectText, RelativeSource={RelativeSource AncestorType=local:ExamItemBox}}" />

        <TextBlock
            Grid.Column="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontFamily="{StaticResource Num}"
            FontSize="23"
            Foreground="#7A7A7A"
            Text="{Binding TimeText, RelativeSource={RelativeSource AncestorType=local:ExamItemBox}}" />
        <TextBlock
            Grid.Column="2"
            Margin="0,0,5,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            FontFamily="{StaticResource Num}"
            FontSize="23"
            Foreground="#7A7A7A"
            Text="{Binding DurationText, RelativeSource={RelativeSource AncestorType=local:ExamItemBox}}" />

    </Grid>
</UserControl>
