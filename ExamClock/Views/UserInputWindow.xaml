<Window x:Class="ExamClock.Views.UserInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:ExamClock.Views"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="用户输入"
        Width="380"
        Height="160"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      CornerRadius="10"
                      GlassFrameThickness="-1"
                      ResizeBorderThickness="5"
                      UseAeroCaptionButtons="True" />
    </WindowChrome.WindowChrome>

    <Border BorderThickness="1"
            Background="White"
            BorderBrush="LightGray">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="70" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>
            <!--  标题栏  -->
            <Border Grid.Row="0"
                    Height="30"
                    Background="#F3F3F3">
                <Grid>
                    <TextBlock Margin="14,0,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Text="用户输入"
                               FontSize="14" />
                    <Button Name="CloseWindowButton"
                            Width="30"
                            Height="30"
                            HorizontalAlignment="Right"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseWindowButton_Click">
                        <Button.Template>
                            <ControlTemplate>
                                <Image Source="/Views/Images/Close_Gray.png" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
            <hc:TextBox Name="InputTextBox"
                        Grid.Row="1"
                        Height="40"
                        Margin="30 20 30 0"
                        FontSize="17"
                        hc:InfoElement.Placeholder="这是标题"/>

            <TextBlock Name="WarningTextBlock"
                       Padding="0"
                       Grid.Row="3"
                       Margin="38,0,0,0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Text=""
                       FontSize="16"
                       Foreground="#BF1515" />
            <Button Name="SubmitButton"
                    Grid.Row="3"
                    Width="119"
                    Content="确认"
                    FontSize="15"
                    Height="40"
                    IsDefault="True"
                    Margin="0,0,30,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="SubmitButton_Click">
            </Button>
        </Grid>
    </Border>
</Window>