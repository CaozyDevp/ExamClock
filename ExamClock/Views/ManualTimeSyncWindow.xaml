<Window x:Class="ExamClock.Views.ManualTimeSyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ExamClock.ViewModels"
        xmlns:local="clr-namespace:ExamClock.Views"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Title="手动时间同步" Height="550" Width="550">
    <Window.DataContext>
        <vm:ManualTimeSyncViewModel/>
    </Window.DataContext>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      CornerRadius="10"
                      GlassFrameThickness="-1"
                      ResizeBorderThickness="5"
                      UseAeroCaptionButtons="True" />
    </WindowChrome.WindowChrome>
    <Border BorderThickness="1"
            Background="White"
            BorderBrush="LightGray">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!--  标题栏  -->
            <Border Grid.Row="0"
                    Height="30"
                    Background="#F3F3F3">
                <Grid>
                    <TextBlock Margin="14,0,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Text="手动时间同步"
                               FontSize="14" />
                    <Button Name="CloseWindowButton"
                            Width="30"
                            Height="30"
                            HorizontalAlignment="Right"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseWindowButton_Click">
                        <Button.Template>
                            <ControlTemplate>
                                <Image Source="/Views/Images/Close_Gray.png" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid Margin="52,0,38,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="46" />
                        <RowDefinition Height="43" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="13" />
                        <RowDefinition Height="62" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="1"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Text="手动时间同步"
                               FontFamily="{StaticResource Hei}"
                               FontSize="30"
                               Foreground="#2E4959" />
                    <TextBlock Grid.Row="2"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Text="选择一个目标主机以同步系统时间"
                               FontFamily="{StaticResource Hei}"
                               FontSize="16"
                               Foreground="#D2D2D2" />

                    <ScrollViewer Grid.Row="3"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SyncItemElements}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Row="5"
                            Width="142"
                            Height="45"
                            Content="{Binding FindButtonText}"
                            IsEnabled="{Binding CanFind}"
                            FontSize="18"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Command="{Binding FindHostsCommand}">
                    </Button>

                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
