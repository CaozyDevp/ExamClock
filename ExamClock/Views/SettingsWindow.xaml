<Window x:Class="ExamClock.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:uc="clr-namespace:ExamClock.Views.UserControls"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:vm="clr-namespace:ExamClock.ViewModels"
        Title="SettingsWindow"
        Width="570"
        Height="610"
        ResizeMode="NoResize"
        Topmost="False"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d">
    <Window.DataContext>
        <vm:SettingsViewModel />
    </Window.DataContext>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="90"
                      CornerRadius="10"
                      GlassFrameThickness="-1"
                      ResizeBorderThickness="5" />
    </WindowChrome.WindowChrome>

    <Border BorderThickness="1"
            Background="White"
            BorderBrush="LightGray">
        <StackPanel>
            <!--  标题栏  -->
            <Border Height="30"
                    Background="#F3F3F3">
                <Grid>
                    <TextBlock Margin="14,0,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Text="设置"
                               FontSize="14" />
                    <Button Width="30"
                            Height="30"
                            HorizontalAlignment="Right"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Command="{Binding CloseWindowCommand}">
                        <Button.Template>
                            <ControlTemplate>
                                <Image Source="/Views/Images/Close_Gray.png" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!--  Tab栏  -->
            <Border Height="60"
                    Background="#F3F3F3">
                <Grid Margin="30,0,30,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <!--  悬浮滑块  -->
                    <Border Grid.Column="{Binding CurrentGrid}"
                            Grid.ColumnSpan="1"
                            Width="110"
                            Height="46"
                            Background="White"
                            CornerRadius="23">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6"
                                              Direction="0"
                                              Opacity="0.13"
                                              ShadowDepth="0"
                                              Color="Black" />
                        </Border.Effect>
                    </Border>

                    <Button Name="OverallButton"
                            Grid.Column="0"
                            Command="{Binding TurnToGrid0Command}"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.Template>
                            <ControlTemplate>
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Text="总览"
                                           FontSize="18"
                                           Foreground="{Binding Grid0TextBrush}" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Name="ArrangementButton"
                            Grid.Column="1"
                            Command="{Binding TurnToGrid1Command}"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.Template>
                            <ControlTemplate>
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Text="安排"
                                           FontSize="18"
                                           Foreground="{Binding Grid1TextBrush}" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Name="AnnouncementButton"
                            Grid.Column="2"
                            Command="{Binding TurnToGrid2Command}"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.Template>
                            <ControlTemplate>
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Text="提醒"
                                           FontSize="18"
                                           Foreground="{Binding Grid2TextBrush}" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Name="CollaborationButton"
                            Grid.Column="3"
                            Command="{Binding TurnToGrid3Command}"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.Template>
                            <ControlTemplate>
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Text="集控"
                                           FontSize="18"
                                           Foreground="{Binding Grid3TextBrush}" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!--  【总览】页面  -->
            <Grid Name="OutlineGrid"
                  Visibility="{Binding OutlineGridVisibility}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="45" />
                        <RowDefinition Height="413" />
                        <RowDefinition Height="62" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Bottom"
                               Text="{Binding NoticeText}"
                               FontFamily="{StaticResource Hei}"
                               FontSize="20"
                               Foreground="#8D8D8D" />
                    <Border Grid.Row="1"
                            Width="514"
                            Height="393"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="White"
                            BorderThickness="0"
                            CornerRadius="23">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6"
                                              Direction="0"
                                              Opacity="0.16"
                                              ShadowDepth="0"
                                              Color="Black" />
                        </Border.Effect>
                        <ScrollViewer Width="514"
                                      Height="350"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ExamElements, Mode=TwoWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Margin="38,0,43,0"
                                                    VerticalAlignment="Top"
                                                    Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <Button Grid.Row="2"
                            Width="150"
                            Height="40"
                            Margin="52,6,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Command="{Binding EditRoomNumberCommand}">
                        <Button.Template>
                            <ControlTemplate>
                                <TextBlock Text="{Binding RoomNumberText}"
                                           FontFamily="{StaticResource Hei}"
                                           FontSize="20"
                                           Foreground="#8D8D8D" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Row="2"
                            Width="142"
                            Height="45"
                            Margin="0,0,38,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Command="{Binding ImportConfigCommand}">
                        <Button.Template>
                            <ControlTemplate>
                                <Border Background="{StaticResource ShallowBlueBrush}"
                                        BorderBrush="{StaticResource BorderBlueBrush}"
                                        BorderThickness="2"
                                        CornerRadius="23">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="41" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0"
                                               Width="19"
                                               Height="19"
                                               HorizontalAlignment="Right"
                                               Source="/Views/Images/Import.png" />
                                        <TextBlock Grid.Column="2"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   Text="导入配置"
                                                   FontFamily="{StaticResource Hei}"
                                                   FontSize="18"
                                                   Foreground="#0099FF" />
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="10"
                                              Direction="0"
                                              Opacity="0.2"
                                              ShadowDepth="0"
                                              Color="#0099FF" />
                        </Button.Effect>
                    </Button>
                </Grid>
            </Grid>

            <!--  【安排】页面  -->
            <Grid Name="ArrangementGrid"
                  Visibility="{Binding ArrangementGridVisibility}">
                <Grid Margin="52,0,38,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="46" />
                        <RowDefinition Height="33" />
                        <RowDefinition Height="330" />
                        <RowDefinition Height="13" />
                        <RowDefinition Height="62" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="1"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Text="考试日程安排"
                               FontFamily="{StaticResource Hei}"
                               FontSize="30"
                               Foreground="#2E4959" />
                    <TextBlock Grid.Row="2"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Text="格式：科目 日期 开始时间 时长"
                               FontFamily="{StaticResource Hei}"
                               FontSize="16"
                               Foreground="#D2D2D2" />
                    <TextBox Grid.Row="3"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch"
                             VerticalContentAlignment="Top"
                             Padding="5"
                             AcceptsReturn="True"
                             FontFamily="微软雅黑"
                             FontSize="18"
                             Foreground="#8D8D8D"
                             Text="{Binding TimeTableText}"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" />

                    <Button Grid.Row="5"
                            Width="142"
                            Height="45"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Command="{Binding SaveArrangementCommand}">
                        <Button.Template>
                            <ControlTemplate>
                                <Border Background="{StaticResource ShallowBlueBrush}"
                                        BorderBrush="{StaticResource BorderBlueBrush}"
                                        BorderThickness="2"
                                        CornerRadius="23">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="41" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0"
                                               Width="17"
                                               Height="19"
                                               HorizontalAlignment="Right"
                                               Source="/Views/Images/Save.png" />
                                        <TextBlock Grid.Column="2"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   Text="保存修改"
                                                   FontFamily="{StaticResource Hei}"
                                                   FontSize="18"
                                                   Foreground="#0099FF" />
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="10"
                                              Direction="0"
                                              Opacity="0.2"
                                              ShadowDepth="0"
                                              Color="#0099FF" />
                        </Button.Effect>
                    </Button>
                </Grid>
            </Grid>

            <!--  【提醒】页面  -->
            <Grid Name="AnnouncementGrid"
                  Visibility="{Binding AnnouncementGridVisibility}">
                <Grid Margin="52,0,50,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="74" />
                        <RowDefinition Height="160" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="1"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Text="语音提醒"
                               FontFamily="{StaticResource Hei}"
                               FontSize="30"
                               Foreground="#2E4959" />
                    <StackPanel Grid.Row="2">
                        <uc:AnnouncementEditor Height="50"
                                               AnnouncementName="开考铃声"
                                               AnnouncementOptions="{Binding OnOffOptions}"
                                               AudioType="{Binding ExamBeginningSoundType}"
                                               SelectedIndex="{Binding SelectedExamBeginningIndex, Mode=TwoWay}" />
                        <uc:AnnouncementEditor Height="50"
                                               AnnouncementName="收卷前提醒"
                                               AnnouncementOptions="{Binding NoticeBeforeEndingOptions}"
                                               AudioType="{Binding NoticeBeforeEndingSoundType}"
                                               SelectedIndex="{Binding SelectedNoticeBeforeEndingIndex, Mode=TwoWay}" />
                        <uc:AnnouncementEditor Height="50"
                                               AnnouncementName="结束铃声"
                                               AnnouncementOptions="{Binding OnOffOptions}"
                                               AudioType="{Binding ExamEndingSoundType}"
                                               SelectedIndex="{Binding SelectedExamEndingIndex, Mode=TwoWay}" />
                    </StackPanel>

                </Grid>
            </Grid>

            <!--  【集控】页面  -->
            <Grid Name="CalibrationGrid"
                  Visibility="{Binding CalibrationGridVisibility}">
                <Grid Margin="52,0,50,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="46" />
                        <RowDefinition Height="43" />
                        <RowDefinition Height="320" />
                        <RowDefinition Height="13" />
                        <RowDefinition Height="62" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="1"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Text="集控配置"
                               FontFamily="{StaticResource Hei}"
                               FontSize="30"
                               Foreground="#2E4959" />
                    <TextBlock Grid.Row="2"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Text="由考试管理中心统一下发，请勿随意修改"
                               FontFamily="{StaticResource Hei}"
                               FontSize="16"
                               Foreground="#D2D2D2" />
                    <StackPanel Grid.Row="3">
                        <hc:Card Height="86"
                                 hc:BorderElement.CornerRadius="10"
                                 BorderThickness="2"
                                 Margin="0 0 0 5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="295" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0"
                                       Source="/Views/Images/Key.png"
                                       Width="24" />
                                <TextBlock Grid.Column="1"
                                           Text="公钥"
                                           FontSize="21"
                                           Foreground="#6B6B6B"
                                           FontFamily="{StaticResource Hei}"
                                           Margin="0 15 0 0"
                                           VerticalAlignment="Top"
                                           HorizontalAlignment="Left"
                                           Padding="0" />
                                <TextBlock Grid.Column="1"
                                           Text="用于识别和鉴定管理端发出的指令"
                                           FontSize="16"
                                           Foreground="#D2D2D2"
                                           FontFamily="{StaticResource Hei}"
                                           Margin="0 0 0 15"
                                           VerticalAlignment="Bottom"
                                           HorizontalAlignment="Left"
                                           Padding="0" />
                                <Button Grid.Column="2"
                                        Height="40"
                                        Width="80"
                                        BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate>
                                            <TextBlock Text="{Binding IsKeyLoadedString}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       FontFamily="{StaticResource Hei}"
                                                       FontSize="21"
                                                       Foreground="{Binding IsKeyLoadedBrush}" />
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </hc:Card>
                        <hc:Card Height="86"
                                 hc:BorderElement.CornerRadius="10"
                                 BorderThickness="2"
                                 Margin="0 0 0 5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="295" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0"
                                       Source="/Views/Images/Lock.png"
                                       Width="22" />
                                <TextBlock Grid.Column="1"
                                           Text="控制权限"
                                           FontSize="21"
                                           Foreground="#6B6B6B"
                                           FontFamily="{StaticResource Hei}"
                                           Margin="0 15 0 0"
                                           VerticalAlignment="Top"
                                           HorizontalAlignment="Left"
                                           Padding="0" />
                                <TextBlock Grid.Column="1"
                                           Text="授权管理端对本机的控制权"
                                           FontSize="16"
                                           Foreground="#D2D2D2"
                                           FontFamily="{StaticResource Hei}"
                                           Margin="0 0 0 15"
                                           VerticalAlignment="Bottom"
                                           HorizontalAlignment="Left"
                                           Padding="0" />
                                <Button Grid.Column="2"
                                        Height="40"
                                        Width="80"
                                        BorderThickness="0"
                                        Command="{Binding PermissionSwitchCommand}">
                                    <Button.Template>
                                        <ControlTemplate>
                                            <TextBlock Text="{Binding PermissionString}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       FontSize="21"
                                                       FontFamily="{StaticResource Hei}"
                                                       Foreground="{Binding PermissionBrush}" />
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </hc:Card>
                    </StackPanel>

                    <Button Grid.Row="5"
                            Width="160"
                            Height="45"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Command="{Binding ShowTimeSyncWindowCommand}">
                        <Button.Template>
                            <ControlTemplate>
                                <Border Background="{StaticResource ShallowBlueBrush}"
                                        BorderBrush="{StaticResource BorderBlueBrush}"
                                        BorderThickness="2"
                                        CornerRadius="23">
                                    <TextBlock Grid.Column="2"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Text="手动时间同步"
                                               FontFamily="{StaticResource Hei}"
                                               FontSize="18"
                                               Foreground="#0099FF" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="10"
                                              Direction="0"
                                              Opacity="0.2"
                                              ShadowDepth="0"
                                              Color="#0099FF" />
                        </Button.Effect>
                    </Button>
                </Grid>
            </Grid>
        </StackPanel>
    </Border>
</Window>