<Window x:Class="ExamClock.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:uc="clr-namespace:ExamClock.Views.UserControls"
        xmlns:vm="clr-namespace:ExamClock.ViewModels"
        Title="SettingsWindow"
        Width="570"
        Height="610"
        ResizeMode="NoResize"
        Topmost="False"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d">
    <Window.DataContext>
        <vm:SettingsViewModel />
    </Window.DataContext>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="90"
                      CornerRadius="10"
                      GlassFrameThickness="-1"
                      ResizeBorderThickness="5" />
    </WindowChrome.WindowChrome>
    <StackPanel>
        <!--  标题栏  -->
        <Border Height="30"
                Background="#F3F3F3">
            <Grid>
                <Label Margin="14,0,0,0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Content="设置"
                       FontFamily="{StaticResource Hei}"
                       FontSize="15" />
                <Button Width="30"
                        Height="30"
                        HorizontalAlignment="Right"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Command="{Binding CloseWindowCommand}">
                    <Button.Template>
                        <ControlTemplate>
                            <Image Source="/Views/Images/Close_Gray.png" />
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!--  Tab栏  -->
        <Border Height="60"
                Background="#F3F3F3">
            <Grid Margin="30,0,30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <!--  悬浮滑块  -->
                <Border Grid.Column="{Binding CurrentGrid}"
                        Grid.ColumnSpan="1"
                        Width="110"
                        Height="46"
                        Background="White"
                        CornerRadius="23">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6"
                                          Direction="0"
                                          Opacity="0.13"
                                          ShadowDepth="0"
                                          Color="Black" />
                    </Border.Effect>
                </Border>

                <Button Name="OverallButton"
                        Grid.Column="0"
                        Command="{Binding TurnToGrid0Command}"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.Template>
                        <ControlTemplate>
                            <Label HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Content="总览"
                                   FontFamily="{StaticResource Hei}"
                                   FontSize="20"
                                   Foreground="{Binding Grid0TextBrush}" />
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Name="ArrangementButton"
                        Grid.Column="1"
                        Command="{Binding TurnToGrid1Command}"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.Template>
                        <ControlTemplate>
                            <Label HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Content="安排"
                                   FontFamily="{StaticResource Hei}"
                                   FontSize="20"
                                   Foreground="{Binding Grid1TextBrush}" />
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Name="AnnouncementButton"
                        Grid.Column="2"
                        Command="{Binding TurnToGrid2Command}"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.Template>
                        <ControlTemplate>
                            <Label HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Content="播报"
                                   FontFamily="{StaticResource Hei}"
                                   FontSize="20"
                                   Foreground="{Binding Grid2TextBrush}" />
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Name="CollaborationButton"
                        Grid.Column="3"
                        Command="{Binding TurnToGrid3Command}"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.Template>
                        <ControlTemplate>
                            <Label HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Content="校时"
                                   FontFamily="{StaticResource Hei}"
                                   FontSize="20"
                                   Foreground="{Binding Grid3TextBrush}" />
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!--  【总览】页面  -->
        <Grid Name="OutlineGrid"
              Visibility="{Binding OutlineGridVisibility}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="45" />
                    <RowDefinition Height="413" />
                    <RowDefinition Height="62" />
                </Grid.RowDefinitions>
                <Label Grid.Row="0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Content="{Binding NoticeText}"
                       FontFamily="{StaticResource Hei}"
                       FontSize="20"
                       Foreground="#8D8D8D" />
                <Border Grid.Row="1"
                        Width="514"
                        Height="393"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="White"
                        BorderThickness="0"
                        CornerRadius="23">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6"
                                          Direction="0"
                                          Opacity="0.16"
                                          ShadowDepth="0"
                                          Color="Black" />
                    </Border.Effect>
                    <ScrollViewer Width="514"
                                  Height="350"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ExamElements, Mode=TwoWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Margin="38,0,43,0"
                                                VerticalAlignment="Top"
                                                Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <Button Grid.Row="2"
                        Width="150"
                        Height="40"
                        Margin="52,6,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Command="{Binding EditRoomNumberCommand}">
                    <Button.Template>
                        <ControlTemplate>
                            <Label Content="{Binding RoomNumberText}"
                                   FontFamily="{StaticResource Hei}"
                                   FontSize="20"
                                   Foreground="#8D8D8D" />
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Grid.Row="2"
                        Width="142"
                        Height="45"
                        Margin="0,0,38,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Command="{Binding ImportConfigCommand}">
                    <Button.Template>
                        <ControlTemplate>
                            <Border Background="{StaticResource ShallowBlueBrush}"
                                    BorderBrush="{StaticResource BorderBlueBrush}"
                                    BorderThickness="2"
                                    CornerRadius="23">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="41" />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0"
                                           Width="19"
                                           Height="19"
                                           HorizontalAlignment="Right"
                                           Source="/Views/Images/Import.png" />
                                    <Label Grid.Column="2"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Content="导入配置"
                                           FontFamily="{StaticResource Hei}"
                                           FontSize="18"
                                           Foreground="#0099FF" />
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="10"
                                          Direction="0"
                                          Opacity="0.2"
                                          ShadowDepth="0"
                                          Color="#0099FF" />
                    </Button.Effect>
                </Button>
            </Grid>
        </Grid>

        <!--  【安排】页面  -->
        <Grid Name="ArrangementGrid"
              Visibility="{Binding ArrangementGridVisibility}">
            <Grid Margin="52,0,38,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="46" />
                    <RowDefinition Height="33" />
                    <RowDefinition Height="330" />
                    <RowDefinition Height="13" />
                    <RowDefinition Height="62" />
                </Grid.RowDefinitions>

                <Label Grid.Row="1"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Content="考试日程安排"
                       FontFamily="{StaticResource Hei}"
                       FontSize="30"
                       Foreground="#2E4959" />
                <Label Grid.Row="2"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Content="格式：科目 日期 开始时间 时长"
                       FontFamily="{StaticResource Hei}"
                       FontSize="16"
                       Foreground="#D2D2D2" />
                <TextBox Grid.Row="3"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch"
                         AcceptsReturn="True"
                         FontFamily="微软雅黑"
                         FontSize="18"
                         Foreground="#8D8D8D"
                         Text="{Binding TimeTableText}"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" />

                <Button Grid.Row="5"
                        Width="142"
                        Height="45"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Command="{Binding SaveArrangementCommand}">
                    <Button.Template>
                        <ControlTemplate>
                            <Border Background="{StaticResource ShallowBlueBrush}"
                                    BorderBrush="{StaticResource BorderBlueBrush}"
                                    BorderThickness="2"
                                    CornerRadius="23">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="41" />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0"
                                           Width="17"
                                           Height="19"
                                           HorizontalAlignment="Right"
                                           Source="/Views/Images/Save.png" />
                                    <Label Grid.Column="2"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Content="保存修改"
                                           FontFamily="{StaticResource Hei}"
                                           FontSize="18"
                                           Foreground="#0099FF" />
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="10"
                                          Direction="0"
                                          Opacity="0.2"
                                          ShadowDepth="0"
                                          Color="#0099FF" />
                    </Button.Effect>
                </Button>


            </Grid>
        </Grid>

        <!--  【播报】页面  -->
        <Grid Name="AnnouncementGrid"
              Visibility="{Binding AnnouncementGridVisibility}">
            <Grid Margin="52,0,50,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="74" />
                    <RowDefinition Height="160" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Label Grid.Row="1"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Content="语音播报"
                       FontFamily="{StaticResource Hei}"
                       FontSize="30"
                       Foreground="#2E4959" />
                <StackPanel Grid.Row="2">
                    <uc:AnnouncementEditor Height="50"
                                           AnnouncementName="开考铃声"
                                           AnnouncementOptions="{Binding OnOffOptions}"
                                           AudioType="{Binding ExamBeginningSoundType}"
                                           SelectedIndex="{Binding SelectedExamBeginningIndex, Mode=TwoWay}" />
                    <uc:AnnouncementEditor Height="50"
                                           AnnouncementName="收卷前播报"
                                           AnnouncementOptions="{Binding NoticeBeforeEndingOptions}"
                                           AudioType="{Binding NoticeBeforeEndingSoundType}"
                                           SelectedIndex="{Binding SelectedNoticeBeforeEndingIndex, Mode=TwoWay}" />
                    <uc:AnnouncementEditor Height="50"
                                           AnnouncementName="结束铃声"
                                           AnnouncementOptions="{Binding OnOffOptions}"
                                           AudioType="{Binding ExamEndingSoundType}"
                                           SelectedIndex="{Binding SelectedExamEndingIndex, Mode=TwoWay}" />
                </StackPanel>

            </Grid>
        </Grid>

        <!--  【校时】页面  -->
        <Grid Name="CalibrationGrid"
              Visibility="{Binding CalibrationGridVisibility}">
            <Grid Margin="52,0,38,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="46" />
                    <RowDefinition Height="43" />
                    <RowDefinition Height="320" />
                    <RowDefinition Height="13" />
                    <RowDefinition Height="62" />
                </Grid.RowDefinitions>

                <Label Grid.Row="1"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Content="系统时间校准"
                       FontFamily="{StaticResource Hei}"
                       FontSize="30"
                       Foreground="#2E4959" />
                <Label Grid.Row="2"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Content="选择一个目标主机以校准系统时间"
                       FontFamily="{StaticResource Hei}"
                       FontSize="16"
                       Foreground="#D2D2D2" />

                <ItemsControl Grid.Row="3"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              ItemsSource="{Binding SyncItemElements, Mode=TwoWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>


                <Button Grid.Row="5"
                        Width="142"
                        Height="45"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Command="{Binding FindHostsCommand}">
                    <Button.Template>
                        <ControlTemplate>
                            <Border Background="{StaticResource ShallowBlueBrush}"
                                    BorderBrush="{StaticResource BorderBlueBrush}"
                                    BorderThickness="2"
                                    CornerRadius="23">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="41" />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0"
                                           Width="20"
                                           Height="20"
                                           HorizontalAlignment="Right"
                                           Source="/Views/Images/Search.png" />
                                    <Label Grid.Column="2"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Content="{Binding FindButtonText}"
                                           FontFamily="{StaticResource Hei}"
                                           FontSize="18"
                                           Foreground="#0099FF" />
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="10"
                                          Direction="0"
                                          Opacity="0.2"
                                          ShadowDepth="0"
                                          Color="#0099FF" />
                    </Button.Effect>
                </Button>

            </Grid>
        </Grid>
    </StackPanel>
</Window>